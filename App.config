<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <add key="ControllerCode" value="" />
    <add key="ControllerName" value="NSP Gatekeeper Controller" />
    <add key="CoreApiBaseUrl" value="" />
    <add key="CoreApiClientId" value="" />
    <add key="CoreApiClientSecret" value="" />
    <add key="CoreApiDatabase" value="" />
    <add key="CoreApiTimeoutSec" value="15" />

    <add key="DiscoveryEnabled" value="true" />
    <add key="DiscoveryServiceType" value="_nsp._tcp.local" />
    <add key="DiscoveryTimeoutMs" value="5000" />

    <add key="HeartbeatIntervalSec" value="30" />
    <add key="DeviceConfigIntervalSec" value="20" />
    <add key="DeviceStatusIntervalSec" value="30" />
    <add key="DetectionPushIntervalMs" value="200" />
    <add key="DetectionBatchSize" value="250" />
    <add key="MeasurementPollIntervalSec" value="2" />
    <add key="MeasurementPushIntervalMs" value="200" />
    <add key="MeasurementBatchSize" value="100" />
    <add key="CleanupIntervalSec" value="3600" />
    <add key="SentDetectionRetentionDays" value="7" />

    <!-- Set the application password during deployment; no production password is stored in source. -->
    <add key="PostgreSqlConnectionString" value="Host=127.0.0.1;Port=5432;Database=nsp_db;Username=parking_log_user;Password=123456aA@;Pooling=true" />
    <!-- Optional first-start bootstrap credential. Leave blank when role/database are provisioned by deployment. -->
    <add key="PostgreSqlAdminConnectionString" value="123456aA@" />
    <add key="LogDirectory" value="logs" />
  </appSettings>
</configuration>
